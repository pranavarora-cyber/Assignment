<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description"
    content="Responsive product listing using CSS Flexbox flex-wrap." />
  <title>Pranav Store - Flex Wrap Products</title>
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      font-family: system-ui, sans-serif;
      background: #f4f4f8;
    }
    header {
      background: #222;
      color: #fff;
      padding: 1rem 2rem;
    }
    header h1 {
      margin: 0;
    }
    .products {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem;
      padding: 1.5rem;
      max-width: 1200px;
      margin: 0 auto;
    }
    .product {
      flex: 1 1 240px;
      max-width: 300px;
      background: #fff;
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
    }
    .product img {
      width: 100%;
      height: 170px;
      object-fit: cover;
    }
    .product__body {
      padding: 1rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .product__body h2 {
      font-size: 1.05rem;
      margin: 0 0 0.4rem;
    }
    .product__body p {
      margin: 0 0 1rem;
      color: #666;
      font-size: 0.9rem;
    }
    .product__footer {
      margin-top: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .price {
      font-weight: 700;
      font-size: 1.1rem;
    }
    button {
      background: #ff6b35;
      color: #fff;
      border: 0;
      padding: 0.5rem 1rem;
      border-radius: 6px;
      cursor: pointer;
    }
    button:hover {
      background: #d94f20;
    }
  </style>
</head>
<body>
  <header>
    <h1>Pranav Store</h1>
  </header>
  <main class="products">
    <article class="product">
      <img
        src="https://picsum.photos/id/1/400/300"
        alt="Laptop on a desk"
      />
      <div class="product__body">
        <h2>Laptop Pro 14</h2>
        <p>
          Fast, light and suitable for programming and AI development.
        </p>
        <div class="product__footer">
          <span class="price">₹64,999</span>
          <button type="button">Add</button>
        </div>
      </div>
    </article>
    <article class="product">
      <img
        src="https://picsum.photos/id/3/400/300"
        alt="Keyboard and monitor setup"
      />
      <div class="product__body">
        <h2>Mechanical Keyboard</h2>
        <p>
          Tactile switches with RGB backlight and comfortable typing.
        </p>
        <div class="product__footer">
          <span class="price">₹4,499</span>
          <button type="button">Add</button>
        </div>
      </div>
    </article>
    <article class="product">
      <img
        src="https://picsum.photos/id/26/400/300"
        alt="Smart watch beside a notebook"
      />
      <div class="product__body">
        <h2>Smart Watch</h2>
        <p>
          Track steps, sleep and daily activities.
        </p>
        <div class="product__footer">
          <span class="price">₹3,299</span>
          <button type="button">Add</button>
        </div>
      </div>
    </article>
    <article class="product">
      <img
        src="https://picsum.photos/id/96/400/300"
        alt="Black headphones"
      />
      <div class="product__body">
        <h2>Headphones</h2>
        <p>
          Noise-cancelling headphones with long battery life.
        </p>
        <div class="product__footer">
          <span class="price">₹2,799</span>
          <button type="button">Add</button>
        </div>
      </div>
    </article>
    <article class="product">
      <img
        src="https://picsum.photos/id/250/400/300"
        alt="Camera lens"
      />
      <div class="product__body">
        <h2>DSLR Camera</h2>
        <p>
          24 MP sensor with high-quality image and video recording.
        </p>
        <div class="product__footer">
          <span class="price">₹42,000</span>
          <button type="button">Add</button>
        </div>
      </div>
    </article>
  </main>
</body>
</html>
