<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Pranav AI landing page using CSS Grid and Flexbox.">
  <title>Pranav AI – Grid and Flexbox Landing</title>
  <style>
    :root {
      --blue: #3a5bff;
      --dark: #0f1535;
    }
    * {
      box-sizing: border-box;
      margin: 0;
    }
    body {
      font-family: system-ui, sans-serif;
      color: var(--dark);
      line-height: 1.6;
    }
    a {
      text-decoration: none;
      color: inherit;
    }
    /* GRID: Overall page layout */
    .page {
      display: grid;
      grid-template-rows: auto auto auto auto auto;
    }
    .wrap {
      width: min(1100px, 92%);
      margin-inline: auto;
    }
    /* FLEX: Navigation bar */
    .nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-block: 1rem;
    }
    .nav ul {
      display: flex;
      gap: 1.5rem;
      list-style: none;
      align-items: center;
    }
    .logo {
      font-weight: 800;
      font-size: 1.4rem;
      color: var(--blue);
    }
    /* GRID: Hero section */
    .hero {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 3rem;
      padding-block: 4rem;
    }
    .hero h1 {
      font-size: clamp(2.2rem, 5vw, 3.4rem);
      line-height: 1.1;
      margin-bottom: 1rem;
    }
    .hero p {
      margin-bottom: 1.5rem;
      color: #4b5280;
    }
    /* FLEX: Button group */
    .btns {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .btn {
      display: inline-block;
      padding: 0.8rem 1.6rem;
      border-radius: 10px;
      font-weight: 700;
      background: var(--blue);
      color: #fff;
    }
    .btn--ghost {
      background: transparent;
      color: var(--blue);
      border: 2px solid var(--blue);
    }
    .hero img {
      width: 100%;
      border-radius: 18px;
    }
    /* GRID: Features section */
    .features {
      background: #f2f4ff;
      padding-block: 4rem;
    }
    .features h2 {
      text-align: center;
      margin-bottom: 2rem;
    }
    .features__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
    }
    /* FLEX: Feature cards */
    .feature {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
      background: #fff;
      padding: 1.5rem;
      border-radius: 14px;
    }
    .feature span {
      font-size: 2rem;
    }
    /* GRID: Pricing section */
    .pricing {
      padding-block: 4rem;
    }
    .pricing h2 {
      text-align: center;
      margin-bottom: 2rem;
    }
    .pricing__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    /* FLEX: Pricing cards */
    .plan {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      border: 1px solid #d8dcf5;
      border-radius: 14px;
      padding: 1.5rem;
      text-align: center;
    }
    .plan .btn {
      margin-top: auto;
    }
    .plan--pop {
      border: 2px solid var(--blue);
      box-shadow: 0 10px 30px rgba(58, 91, 255, 0.2);
    }
    .price {
      font-size: 2rem;
      font-weight: 800;
    }
    /* FLEX: Footer */
    footer {
      background: var(--dark);
      color: #cdd2f5;
    }
    footer .wrap {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      padding-block: 1.5rem;
    }
    /* Responsive layout */
    @media (max-width: 820px) {
      .hero {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .btns {
        justify-content: center;
      }
      .pricing__grid {
        grid-template-columns: 1fr;
      }
      .nav ul {
        gap: 0.75rem;
      }
    }
    @media (max-width: 520px) {
      .nav {
        flex-direction: column;
        gap: 1rem;
      }
      .nav ul {
        flex-wrap: wrap;
        justify-content: center;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <nav>
      <div class="wrap nav">
        <span class="logo">Pranav AI</span>
        <ul>
          <li><a href="#features">Features</a></li>
          <li><a href="#pricing">Pricing</a></li>
          <li><a class="btn" href="#pricing">Explore</a></li>
        </ul>
      </div>
    </nav>
    <header class="wrap hero">
      <div>
        <h1>Explore technology and build your future.</h1>
        <p>
          I am a BCA Artificial Intelligence student learning
          programming, web development and emerging technologies.
        </p>
        <div class="btns">
          <a class="btn" href="#features">Explore Skills</a>
          <a class="btn btn--ghost" href="#pricing">View Projects</a>
        </div>
      </div>
      <img src="https://picsum.photos/id/0/700/520"
        alt="Person working on a laptop">
    </header>
    <section class="features" id="features">
      <div class="wrap">
        <h2>My Learning Areas</h2>
        <div class="features__grid">
          <div class="feature">
            <span>💻</span>
            <div>
              <h3>Web Development</h3>
              <p>Learning HTML and CSS to build responsive websites.</p>
            </div>
          </div>
          <div class="feature">
            <span>🐍</span>
            <div>
              <h3>Python Programming</h3>
              <p>Developing programming and problem-solving skills.</p>
            </div>
          </div>
          <div class="feature">
            <span>🤖</span>
            <div>
              <h3>Artificial Intelligence</h3>
              <p>Exploring AI concepts and intelligent technologies.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="pricing wrap" id="pricing">
      <h2>My Projects</h2>
      <div class="pricing__grid">
        <div class="plan">
          <h3>HTML Portfolio</h3>
          <p class="price">01</p>
          <p>A personal portfolio built using HTML and CSS.</p>
          <a class="btn btn--ghost" href="#features">Explore</a>
        </div>
        <div class="plan plan--pop">
          <h3>Responsive Website</h3>
          <p class="price">02</p>
          <p>A responsive website using Grid and Flexbox layouts.</p>
          <a class="btn" href="#features">Explore</a>
        </div>
        <div class="plan">
          <h3>Python Projects</h3>
          <p class="price">03</p>
          <p>Programming practice and beginner-level Python projects.</p>
          <a class="btn btn--ghost" href="#features">Explore</a>
        </div>
      </div>
    </section>
    <footer>
      <div class="wrap">
        <span>&copy; 2026 Pranav AI</span>
        <span>Learning Today, Building Tomorrow.</span>
      </div>
    </footer>
  </div>
</body>
</html>
