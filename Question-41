<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Responsive portfolio project with three CSS breakpoints.">
  <title>Pranav's Responsive Portfolio</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
    }
    body {
      font-family: system-ui, sans-serif;
      line-height: 1.6;
      background: #f8f9fc;
      color: #222;
    }
    header {
      background: #1f3a93;
      color: #fff;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 2rem;
    }
    nav {
      display: flex;
      gap: 1.25rem;
    }
    nav a {
      color: #fff;
      text-decoration: none;
    }
    main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem;
    }
    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }
    .card {
      background: #fff;
      padding: 1.25rem;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }
    h1 {
      font-size: 2.6rem;
      margin-bottom: 1.5rem;
    }
    .badge {
      display: inline-block;
      margin-top: 1rem;
      background: #ffe8cc;
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      font-size: 0.85rem;
    }
    /* BREAKPOINT 1: Tablets and small laptops */
    @media (max-width: 1024px) {
      .cards {
        grid-template-columns: repeat(2, 1fr);
      }
      h1 {
        font-size: 2.2rem;
      }
    }
    /* BREAKPOINT 2: Large phones */
    @media (max-width: 768px) {
      header {
        flex-direction: column;
        gap: 0.5rem;
        padding: 1rem;
      }
      main {
        padding: 1.25rem;
      }
      h1 {
        font-size: 1.9rem;
      }
    }
    /* BREAKPOINT 3: Small phones */
    @media (max-width: 480px) {
      .cards {
        grid-template-columns: 1fr;
      }
      nav {
        flex-wrap: wrap;
        justify-content: center;
      }
    }
  </style>
</head>
<body>
  <header>
    <strong>Pranav's Portfolio</strong>
    <nav>
      <a href="#home">Home</a>
      <a href="#about">About</a>
      <a href="#projects">Projects</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>
  <main id="home">
    <h1>My Responsive Portfolio</h1>
    <section class="cards">
      <article class="card" id="home-card">
        <h2>Home</h2>
        <p>Welcome to my personal portfolio website.</p>
      </article>
      <article class="card" id="about">
        <h2>About</h2>
        <p>BCA Artificial Intelligence student at Invertis University.</p>
      </article>
      <article class="card" id="projects">
        <h2>Projects</h2>
        <p>Working on HTML, CSS, Python and AI projects.</p>
      </article>
      <article class="card" id="contact">
        <h2>Contact</h2>
        <p>Thank you for visiting my portfolio.</p>
      </article>
    </section>
    <span class="badge">Layout: 4 columns → 2 columns → 1 column</span>
    <h2 style="margin-top: 2rem">
      Responsive Testing Guide
    </h2>
    <p style="margin-bottom: 1rem">
      Test this webpage using Chrome DevTools and the device toolbar
      (Ctrl + Shift + M).
    </p>
    <div style="overflow-x: auto;">
      <table border="1" cellpadding="6"
        style="border-collapse: collapse; background: #fff; width: 100%;">
        <tr>
          <th>Device / Width</th>
          <th>Expected Layout</th>
        </tr>
        <tr>
          <td>Desktop 1440px</td>
          <td>4 columns</td>
        </tr>
        <tr>
          <td>iPad Air 820px</td>
          <td>2 columns</td>
        </tr>
        <tr>
          <td>iPhone 14 390px</td>
          <td>1 column, stacked header</td>
        </tr>
        <tr>
          <td>Galaxy Fold 280px</td>
          <td>1 column</td>
        </tr>
      </table>
    </div>
  </main>
</body>
</html>
